# 默认 mock 模式无需密钥，可完整体验全部流程。
PROVIDER_MODE=mock
HOST=127.0.0.1
PORT=3000
MATCH_THRESHOLD=0.82
ALLOWED_ORIGIN=http://localhost:5173
# 生产和多副本部署必须使用同一个至少 32 字符的随机密钥。
# PEOPLE_ASSET_SECRET=replace-with-a-long-random-secret
GRANT_TTL_SECONDS=300

# 接入真实 provider 时仅在服务端设置，切勿使用 VITE_ 前缀或提交真实值。
# REAL_FACE_API_URL=https://provider.example/face
# REAL_FACE_API_KEY=replace-on-server
# REAL_DIFFERENCE_API_URL=https://provider.example/difference
# REAL_DIFFERENCE_API_KEY=replace-on-server
# REAL_STORY_API_URL=https://provider.example/story
# REAL_STORY_API_KEY=replace-on-server

# 配置后，故事使用 Azure Speech 情感语音合成；两项必须同时设置。
# AZURE_SPEECH_KEY=replace-on-server
# AZURE_SPEECH_REGION=chinaeast2
AZURE_SPEECH_VOICE=zh-CN-XiaoxiaoNeural
AZURE_SPEECH_STYLE=affectionate
