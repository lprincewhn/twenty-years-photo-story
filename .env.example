# 默认 mock 模式无需密钥，可完整体验全部流程。
PROVIDER_MODE=mock
HOST=127.0.0.1
PORT=3000
MATCH_THRESHOLD=0.6
ALLOWED_ORIGIN=http://localhost:5173
# 生产和多副本部署必须使用同一个至少 32 字符的随机密钥。
# PEOPLE_ASSET_SECRET=replace-with-a-long-random-secret
GRANT_TTL_SECONDS=300

# Azure Face 仅使用 DefaultAzureCredential（生产为 Managed Identity），不支持 API key。
# 以下变量仅在服务端设置，切勿使用 VITE_ 前缀。real 模式全部必填项会在启动时校验。
# AZURE_FACE_ENDPOINT=https://your-face-resource.cognitiveservices.azure.com
# AZURE_FACE_API_VERSION=v1.2
# AZURE_FACE_GROUP_ID=photo-story-people
# AZURE_FACE_DETECTION_MODEL=detection_03
# AZURE_FACE_RECOGNITION_MODEL=recognition_04
# AZURE_FACE_ID_TTL_SECONDS=60
# AZURE_FACE_IDENTIFY_THRESHOLD=0.5
# AZURE_FACE_MAX_CANDIDATES=5
# AZURE_FACE_TIMEOUT_MS=8000
# Microsoft Foundry GPT-5.6 Sol 同样仅使用 DefaultAzureCredential。
# AZURE_FOUNDRY_ENDPOINT=https://your-ai-services-resource.cognitiveservices.azure.com
# AZURE_FOUNDRY_DEPLOYMENT=gpt-5.6-sol
# AZURE_FOUNDRY_TIMEOUT_MS=60000
# 用户指派 Managed Identity 才需要：
# AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Azure Speech 可在 mock 或 real 分析模式下独立启用，同样仅使用 DefaultAzureCredential。
# Endpoint 与完整 Resource ID 必须同时设置。
# AZURE_SPEECH_ENDPOINT=https://your-speech-resource.cognitiveservices.azure.com/
# AZURE_SPEECH_RESOURCE_ID=/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/example/providers/Microsoft.CognitiveServices/accounts/example
# AZURE_SPEECH_VOICE=zh-CN-XiaoxiaoNeural
# AZURE_SPEECH_STYLE=affectionate
